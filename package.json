{
  "name": "les9",
  "private": true,
  "version": "0.0.0",
  "description": "Squelette du monorepo Les9.",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" build",
    "typecheck": "pnpm build:packages && pnpm --filter \"./packages/*\" --filter \"./apps/*\" typecheck",
    "test": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" --if-present test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:web": "pnpm build:packages && pnpm --filter @les9/web dev",
    "dev:api": "pnpm build:packages && pnpm --filter @les9/api build && pnpm --filter @les9/api start",
    "dev:mobile": "pnpm build:packages && pnpm --filter @les9/mobile start"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
